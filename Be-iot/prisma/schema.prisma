// Prisma Schema
// Sensor khusus DHT22 (Temperature & Humidity)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model DHT22 {
  id          Int      @id @default(autoincrement())
  temperature Float
  humidity    Float
  createdAt   DateTime @default(now())
}